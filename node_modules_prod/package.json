{
  "name": "sedir-web-2026-backend",
  "version": "1.0.0",
  "description": "Backend Express de SEDIR con PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "migrar:noticias": "node scripts/migrar-noticias-legacy.js",
    "migrar:publicaciones": "node scripts/migrar-publicaciones-legacy.js",
    "migrar:webinars": "node scripts/migrar-webinars-legacy.js",
    "migrar:webinars-funcionales": "node scripts/migrar-webinars-funcionales.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.js"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}